<ScrollView xmlns:android="http://schemas.android.com/apk/res/android" android:layout_width="match_parent" android:layout_height="match_parent">
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:padding="16dp">
        <TextView
            android:id="@+id/headingTextView"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_margin="8dp"
            android:text="My Previous Complaints"
            android:textSize="24sp"
            android:textStyle="bold"/>
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_margin="8dp"
            android:orientation="vertical">
            <TextView
                android:id="@+id/complaintOneTitleTextView"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="Fan not working in Room 204, Block B"
                android:textSize="18sp"
                android:textStyle="bold"/>
            <TextView
                android:id="@+id/complaintOneCategoryTextView"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="Category: Electricity"
                android:textSize="14sp"/>
            <TextView
                android:id="@+id/complaintOneDateTextView"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="Date: 28 Sep 2026"
                android:textSize="14sp"/>
            <TextView
                android:id="@+id/complaintOneStatusTextView"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="Status: Pending"
                android:textSize="14sp"
                android:textStyle="bold"/>
        </LinearLayout>
        <View
            android:layout_width="match_parent"
            android:layout_height="1dp"
            android:layout_margin="8dp"
            android:background="?android:attr/listDivider"/>
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_margin="8dp"
            android:orientation="vertical">
            <TextView
                android:id="@+id/complaintTwoTitleTextView"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="Wi-Fi not connecting in Library Reading Hall"
                android:textSize="18sp"
                android:textStyle="bold"/>
            <TextView
                android:id="@+id/complaintTwoCategoryTextView"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="Category: Wi-Fi"
                android:textSize="14sp"/>
            <TextView
                android:id="@+id/complaintTwoDateTextView"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="Date: 22 Sep 2026"
                android:textSize="14sp"/>
            <TextView
                android:id="@+id/complaintTwoStatusTextView"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="Status: In Progress"
                android:textSize="14sp"
                android:textStyle="bold"/>
        </LinearLayout>
        <View
            android:layout_width="match_parent"
            android:layout_height="1dp"
            android:layout_margin="8dp"
            android:background="?android:attr/listDivider"/>
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_margin="8dp"
            android:orientation="vertical">
            <TextView
                android:id="@+id/complaintThreeTitleTextView"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="Water cooler leaking on 2nd floor, Block A"
                android:textSize="18sp"
                android:textStyle="bold"/>
            <TextView
                android:id="@+id/complaintThreeCategoryTextView"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="Category: Water"
                android:textSize="14sp"/>
            <TextView
                android:id="@+id/complaintThreeDateTextView"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="Date: 15 Sep 2026"
                android:textSize="14sp"/>
            <TextView
                android:id="@+id/complaintThreeStatusTextView"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="Status: Resolved"
                android:textSize="14sp"
                android:textStyle="bold"/>
        </LinearLayout>
    </LinearLayout>
</ScrollView>